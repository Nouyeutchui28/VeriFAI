# ============================================================================
# VeriFAI LLM - Complete Environment Configuration Guide
# ============================================================================
# Copy this file to .env and fill in your deployment-specific values
# For production, update values as indicated

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite (Development - Default)
DATABASE_URL=sqlite:///./verifai_llm.db

# PostgreSQL (Production - Recommended)
# DATABASE_URL=postgresql://verifai_llm:PASSWORD@localhost:5432/verifai_llm_db

# Optional: Offline SQLite database path for fallback
VERIFAI_OFFLINE_DB=./data/verifai_offline.db

# SQL Echo (Debug mode) - set to "true" to log all SQL queries
SQL_ECHO=false

# ============================================================================
# HUGGINGFACE API CONFIGURATION (REQUIRED FOR AI ANALYSIS)
# ============================================================================
# Get your token at: https://huggingface.co/settings/tokens
# This is REQUIRED for AI security analysis via Qwen2.5-Coder-32B
HF_TOKEN=hf_YOUR_ACTUAL_TOKEN_HERE

# Optional: Use local model instead of HuggingFace inference
# LOCAL_MODEL_NAME=facebook/opt-1.3b

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Generate a new key with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Change this for production!
SECRET_KEY=9478f69595d2c2d27457850a4b4e339d1b6e4d2a9f1a2b3c4d5e6f7a8b9c0d1

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API Base URL
API_BASE_URL=http://localhost:8000

# WebSocket Base URL (for real-time updates)
VERIFAI_WS_BASE_URL=ws://localhost:8000

# CORS Origins (comma-separated) - Add your frontend domains here
CORS_ORIGINS=http://localhost:8501,http://localhost:8502,http://localhost:3000

# For production, update to:
# CORS_ORIGINS=https://your-frontend.com,https://your-api.com

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================
# Run in headless mode (no browser auto-open)
STREAMLIT_SERVER_HEADLESS=true

# Streamlit server binding
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_CLIENT_TOOLBAR_MODE=viewer

# ============================================================================
# SEMGREP CONFIGURATION (REQUIRED FOR CODE SCANNING)
# ============================================================================
# SEMGREP MUST BE INSTALLED!
# Install methods:
#   1. pip install semgrep
#   2. Docker: Already in Dockerfile (line 17)
#   3. System-wide: curl -sSL https://install.semgrep.dev | python -
#
# Verify: semgrep --version

# Semgrep scanning configuration
SEMGREP_CONFIG=auto
SEMGREP_TIMEOUT=60
SEMGREP_JOBS=8
SEMGREP_DISABLE_VERSION_CHECK=true

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Set to "production" for deployed environments
ENVIRONMENT=development

# Python runtime optimization
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# OPTIONAL: GITHUB INTEGRATION
# ============================================================================
# GitHub token for repository scanning (optional)
# Get at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ============================================================================
# OPTIONAL: LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
