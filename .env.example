# Database Configuration
DATABASE_URL=postgresql://verifai_llm:verifai_llm_password@localhost:5432/verifai_llm_db
SQL_ECHO=false

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend API
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://localhost:8502,http://localhost:3000

# OAuth2 Configuration (for future integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Streamlit Configuration
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_MAXUPLOADSIZE=200
